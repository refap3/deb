#!/usr/bin/env bash
# pinginfoview — terminal host-ping monitor
# Usage: pinginfoview [hosts_file]

VERSION="1.10"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOSTS_FILE="${1:-${SCRIPT_DIR}/hosts.txt}"
TMP_BASE="/tmp/pinginfoview_$$"
REFRESH=2
OS_TYPE="$(uname -s)"

# Derive a display label from the hosts filename (e.g. hosts-vienna.txt → VIENNA)
_b="$(basename "$HOSTS_FILE" .txt)"; _b="${_b#hosts}"; _b="${_b#-}"
SITE_LABEL="${_b^^}"

# ── colours / symbols ──────────────────────────────────────────────────────
CG=$'\033[0;32m'; CR=$'\033[0;31m'; CB=$'\033[1m'; CD=$'\033[2m'
CGG=$'\033[1;32m'; CRR=$'\033[1;31m'   # bright variants for snapshot deltas
RS=$'\033[0m'
OK_SYM='✓'; FAIL_SYM='✗'

# ── normal-mode state ──────────────────────────────────────────────────────
hosts=()
PING_PIDS=()    # PIDs of current ping round — killed on exit
SORT_MODE="H"   # H=hostname  I=ip  S=status  T=time
SORT_REV=0      # 0=ascending  1=descending  (H/I/S; T uses T_CYCLE parity)
T_CYCLE=0       # 0=last-fail↑  1=last-fail↓  2=first-fail↑  3=first-fail↓
NORM_CURSOR=0   # selected row index in normal mode

declare -a st_status st_ip st_ok st_fail \
           st_first_ok st_last_ok st_first_fail st_last_fail

# ── scan mode state ────────────────────────────────────────────────────────
SCAN_MODE=0
SCAN_CURSOR=0
SCAN_SUBNET=""
SCAN_SUBNET_DISPLAY=""
SCAN_HOSTS=()
SCAN_NAMES=()
SCAN_OK=()
SCAN_PIDS=()
SCAN_DISPLAY_HOSTS=()   # ordered list built by draw_scan; read by add_host_to_file
declare -A SCAN_UP=()   # ip → 1 for currently responding hosts
SCAN_SORT_MODE="I"      # H=name  I=ip  S=status/ok-count  T=time
SCAN_SORT_REV=0
SCAN_T_CYCLE=0          # 0=last-fail↑  1=last-fail↓  2=first-fail↑  3=first-fail↓
SCAN_SORT_BUF=()        # scratch buffer for get_sorted_scan_hosts

# Per-IP associative maps (all known IPs, up and down — needed for snapshot timestamps)
declare -A SC_OKC=() SC_FLC=()
declare -A SC_FOK=() SC_LOK=() SC_FFL=() SC_LFL=()

# ── snapshot mode state ────────────────────────────────────────────────────
SNAPSHOT_MODE=0
SNAPSHOT_TIME=""
SNAP_HIDE_BG=0              # 1 = hide unchanged (dim) hosts in snapshot view
declare -A SNAP_STATUS=()   # ip → "up" recorded at snapshot time
declare -A SNAP_DROP=()     # ip → 1 once confirmed dropped; stays red until B
declare -A SNAP_SEEN=()     # ip → 1 for every IP seen up during snapshot (incl. new arrivals)
declare -A SNAP_NAMES=()    # ip → last known hostname during snapshot (survives host going down)

# ── flash message (shown in status bar for a few seconds) ─────────────────
FLASH_MSG=""
FLASH_UNTIL=0

# ── cleanup ────────────────────────────────────────────────────────────────
cleanup() {
    trap - EXIT INT TERM HUP
    tput rmcup 2>/dev/null || true
    tput cnorm 2>/dev/null || true
    local pid
    for pid in "${PING_PIDS[@]}" "${SCAN_PIDS[@]}"; do
        kill "$pid" 2>/dev/null || true
    done
    wait 2>/dev/null || true
    rm -rf "$TMP_BASE"
    exit 0
}
trap cleanup EXIT INT TERM HUP

# ── load hosts ─────────────────────────────────────────────────────────────
load_hosts() {
    hosts=()
    if [[ ! -f "$HOSTS_FILE" ]]; then
        echo "Error: hosts file not found: $HOSTS_FILE" >&2
        echo "Create $HOSTS_FILE with one hostname or IP per line." >&2
        exit 1
    fi
    while IFS= read -r line; do
        line="${line%%#*}"          # strip inline comments
        read -r line <<< "$line"   # trim leading/trailing whitespace
        [[ -z "$line" ]] && continue
        hosts+=("$line")
    done < "$HOSTS_FILE"
    if [[ ${#hosts[@]} -eq 0 ]]; then
        echo "Error: no hosts found in $HOSTS_FILE" >&2
        exit 1
    fi
}

# ── state init ─────────────────────────────────────────────────────────────
init_state() {
    rm -rf "$TMP_BASE"
    mkdir -p "$TMP_BASE"
    local i
    for i in "${!hosts[@]}"; do
        local d="$TMP_BASE/$i"
        mkdir -p "$d"
        printf "unknown\n" > "$d/status"
        printf "0\n"       > "$d/ok"
        printf "0\n"       > "$d/fail"
        printf "\n"        > "$d/ip"
        printf "\n"        > "$d/first_ok"
        printf "\n"        > "$d/last_ok"
        printf "\n"        > "$d/first_fail"
        printf "\n"        > "$d/last_fail"
    done
}

# ── IP resolution ──────────────────────────────────────────────────────────
resolve_ip() {
    local host="$1"
    [[ "$host" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && echo "$host" && return
    local ip=""
    if [[ "$OS_TYPE" == "Darwin" ]]; then
        ip=$(dig +short "$host" 2>/dev/null \
             | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -1)
        [[ -z "$ip" ]] && \
            ip=$(host "$host" 2>/dev/null | awk '/has address/{print $NF; exit}')
    else
        ip=$(getent hosts "$host" 2>/dev/null | awk '{print $1; exit}')
        [[ -z "$ip" ]] && \
            ip=$(dig +short "$host" 2>/dev/null \
                 | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -1)
    fi
    echo "$ip"
}

# ── ping worker (runs in background) ───────────────────────────────────────
ping_host() {
    local i="$1" host="$2"
    local d="$TMP_BASE/$i"

    local ip
    ip=$(< "$d/ip")
    if [[ -z "$ip" ]]; then
        ip=$(resolve_ip "$host")
        printf "%s\n" "$ip" > "$d/ip"
    fi

    local now
    now=$(date +%s)

    local ping_ok=1
    if [[ "$OS_TYPE" == "Darwin" ]]; then
        ping -c1 -t1 -q "$host" &>/dev/null || ping_ok=0
    else
        ping -c1 -W1 -q "$host" &>/dev/null || ping_ok=0
    fi

    if (( ping_ok )); then
        printf "up\n" > "$d/status"
        local n; n=$(< "$d/ok"); printf "%d\n" $((n + 1)) > "$d/ok"
        local fo; fo=$(< "$d/first_ok")
        [[ -z "$fo" ]] && printf "%d\n" "$now" > "$d/first_ok"
        printf "%d\n" "$now" > "$d/last_ok"
    else
        printf "down\n" > "$d/status"
        local n; n=$(< "$d/fail"); printf "%d\n" $((n + 1)) > "$d/fail"
        local ff; ff=$(< "$d/first_fail")
        [[ -z "$ff" ]] && printf "%d\n" "$now" > "$d/first_fail"
        printf "%d\n" "$now" > "$d/last_fail"
    fi
}

trigger_pings() {
    PING_PIDS=()
    local i
    for i in "${!hosts[@]}"; do
        ping_host "$i" "${hosts[$i]}" 2>/dev/null &
        PING_PIDS+=($!)
    done
}

# ── read all normal-mode state into arrays ─────────────────────────────────
read_state() {
    local i
    for i in "${!hosts[@]}"; do
        local d="$TMP_BASE/$i"
        st_status[$i]=$(    < "$d/status"    ); : "${st_status[$i]:=unknown}"
        st_ip[$i]=$(        < "$d/ip"        )
        st_ok[$i]=$(        < "$d/ok"        ); : "${st_ok[$i]:=0}"
        st_fail[$i]=$(      < "$d/fail"      ); : "${st_fail[$i]:=0}"
        st_first_ok[$i]=$(  < "$d/first_ok"  )
        st_last_ok[$i]=$(   < "$d/last_ok"   )
        st_first_fail[$i]=$(< "$d/first_fail")
        st_last_fail[$i]=$( < "$d/last_fail" )
    done
}

# ── normal mode: remove highlighted host from hosts file ──────────────────
remove_host_from_file() {
    local total="${#hosts[@]}"
    if (( total <= 1 )); then
        FLASH_MSG="Cannot remove last host"
        FLASH_UNTIL=$(( $(date +%s) + 2 ))
        return
    fi
    (( NORM_CURSOR >= total )) && return

    local sorted_indices=()
    mapfile -t sorted_indices < <(get_sorted_indices)
    local host="${hosts[${sorted_indices[$NORM_CURSOR]}]}"

    local tmp
    tmp=$(mktemp)
    awk -v host="$host" '
    {
        stripped = $0
        sub(/#.*/, "", stripped)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", stripped)
        if (stripped == host) next
        print
    }' "$HOSTS_FILE" > "$tmp" && mv "$tmp" "$HOSTS_FILE"

    FLASH_MSG="Removed ${host} from $(basename "$HOSTS_FILE")"
    FLASH_UNTIL=$(( $(date +%s) + 3 ))

    (( NORM_CURSOR > 0 && NORM_CURSOR >= total - 1 )) && (( NORM_CURSOR-- ))
    load_hosts
    init_state
    trigger_pings
}

# ── scan mode: subnet detection ────────────────────────────────────────────
detect_subnet() {
    local iface local_ip
    if [[ "$OS_TYPE" == "Darwin" ]]; then
        iface=$(route get default 2>/dev/null | awk '/interface:/{print $2}')
        [[ -n "$iface" ]] && local_ip=$(ipconfig getifaddr "$iface" 2>/dev/null)
    fi
    if [[ -z "$local_ip" ]]; then
        local_ip=$(ip -4 route get 1 2>/dev/null \
            | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
    fi
    [[ -z "$local_ip" ]] && local_ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    [[ -z "$local_ip" ]] && return 1
    SCAN_SUBNET="${local_ip%.*}"
    SCAN_SUBNET_DISPLAY="${SCAN_SUBNET}.0/24"
}

# ── scan mode: per-IP ping worker (background) ─────────────────────────────
scan_one_ip() {
    local ip="$1"
    local d="$TMP_BASE/scan/$ip"
    mkdir -p "$d"

    local now
    now=$(date +%s)

    local ping_ok=1
    if [[ "$OS_TYPE" == "Darwin" ]]; then
        ping -c1 -t1 -q "$ip" &>/dev/null || ping_ok=0
    else
        ping -c1 -W1 -q "$ip" &>/dev/null || ping_ok=0
    fi

    if (( ping_ok )); then
        printf "up\n" > "$d/status"
        local n=0
        [[ -f "$d/ok" ]] && n=$(< "$d/ok")
        printf "%d\n" $((n + 1)) > "$d/ok"
        local fo=""; [[ -f "$d/first_ok" ]] && fo=$(< "$d/first_ok")
        [[ -z "$fo" ]] && printf "%d\n" "$now" > "$d/first_ok"
        printf "%d\n" "$now" > "$d/last_ok"
        # Reverse DNS — attempt once per discovered IP
        if [[ ! -f "$d/name_done" ]]; then
            local name=""
            if [[ "$OS_TYPE" == "Darwin" ]]; then
                name=$(dig +short +time=1 -x "$ip" 2>/dev/null | sed 's/\.$//')
                [[ -z "$name" ]] && \
                    name=$(host "$ip" 2>/dev/null \
                        | awk '/domain name pointer/{print $NF}' | sed 's/\.$//')
            else
                name=$(dig +short +time=1 -x "$ip" 2>/dev/null | sed 's/\.$//')
                [[ -z "$name" ]] && \
                    name=$(getent hosts "$ip" 2>/dev/null | awk '{print $2}')
            fi
            printf "%s\n" "$name" > "$d/name"
            touch "$d/name_done"
        fi
    else
        printf "down\n" > "$d/status"
        local n=0
        [[ -f "$d/fail" ]] && n=$(< "$d/fail")
        printf "%d\n" $((n + 1)) > "$d/fail"
        local ff=""; [[ -f "$d/first_fail" ]] && ff=$(< "$d/first_fail")
        [[ -z "$ff" ]] && printf "%d\n" "$now" > "$d/first_fail"
        printf "%d\n" "$now" > "$d/last_fail"
    fi
}

trigger_scan() {
    SCAN_PIDS=()
    local i
    for (( i=1; i<=254; i++ )); do
        scan_one_ip "${SCAN_SUBNET}.$i" 2>/dev/null &
        SCAN_PIDS+=($!)
    done
}

# ── scan mode: read scan results into arrays ───────────────────────────────
read_scan_state() {
    SCAN_HOSTS=()
    SCAN_NAMES=()
    SCAN_OK=()
    SCAN_UP=()
    SC_OKC=(); SC_FLC=()
    SC_FOK=(); SC_LOK=(); SC_FFL=(); SC_LFL=()
    local i
    for (( i=1; i<=254; i++ )); do
        local ip="${SCAN_SUBNET}.$i"
        local d="$TMP_BASE/scan/$ip"
        [[ ! -d "$d" ]] && continue
        local status=""
        [[ -f "$d/status" ]] && status=$(< "$d/status")

        # Populate per-IP maps for all known IPs (up and down)
        local okc=0 flc=0 fok="" lok="" ffl="" lfl=""
        [[ -f "$d/ok" ]]         && okc=$(< "$d/ok")
        [[ -f "$d/fail" ]]       && flc=$(< "$d/fail")
        [[ -f "$d/first_ok" ]]   && fok=$(< "$d/first_ok")
        [[ -f "$d/last_ok" ]]    && lok=$(< "$d/last_ok")
        [[ -f "$d/first_fail" ]] && ffl=$(< "$d/first_fail")
        [[ -f "$d/last_fail" ]]  && lfl=$(< "$d/last_fail")
        SC_OKC["$ip"]="$okc"; SC_FLC["$ip"]="$flc"
        SC_FOK["$ip"]="$fok"; SC_LOK["$ip"]="$lok"
        SC_FFL["$ip"]="$ffl"; SC_LFL["$ip"]="$lfl"

        [[ "$status" != "up" ]] && continue
        SCAN_HOSTS+=("$ip")
        SCAN_UP["$ip"]=1
        local name=""
        [[ -f "$d/name" ]] && name=$(< "$d/name")
        SCAN_NAMES+=("$name")
        SCAN_OK+=("$okc")
    done
}

# ── scan mode: enter / exit ────────────────────────────────────────────────
enter_scan_mode() {
    if ! detect_subnet; then
        FLASH_MSG="Could not detect local subnet"
        FLASH_UNTIL=$(( $(date +%s) + 3 ))
        return
    fi
    SCAN_MODE=1
    SCAN_CURSOR=0
    SCAN_SORT_MODE="I"
    SCAN_SORT_REV=0
    SCAN_T_CYCLE=0
    SNAPSHOT_MODE=0
    SNAP_HIDE_BG=0
    SNAP_STATUS=()
    SNAP_DROP=()
    SNAP_SEEN=()
    SNAP_NAMES=()
    FLASH_MSG=""
    mkdir -p "$TMP_BASE/scan"
    trigger_scan
}

exit_scan_mode() {
    local pid
    for pid in "${SCAN_PIDS[@]}"; do
        kill "$pid" 2>/dev/null || true
    done
    SCAN_PIDS=()
    rm -rf "$TMP_BASE/scan"
    SCAN_MODE=0
    SNAPSHOT_MODE=0
    SNAP_HIDE_BG=0
    SCAN_CURSOR=0
    SNAP_STATUS=()
    SNAP_DROP=()
    SNAP_SEEN=()
    SNAP_NAMES=()
    SCAN_HOSTS=(); SCAN_NAMES=(); SCAN_OK=()
    SCAN_UP=(); SCAN_DISPLAY_HOSTS=()
    # Reinitialise normal mode (hosts file may have changed via A)
    load_hosts
    init_state
    trigger_pings
}

# ── snapshot mode: take / clear ────────────────────────────────────────────
take_snapshot() {
    SNAPSHOT_MODE=1
    SNAPSHOT_TIME=$(date +%H:%M:%S)
    SNAP_HIDE_BG=0
    SNAP_STATUS=()
    SNAP_DROP=()
    SNAP_SEEN=()
    local ip
    for ip in "${SCAN_HOSTS[@]}"; do
        SNAP_STATUS["$ip"]="up"
    done
}

# ── scan mode: add highlighted host to hosts file ──────────────────────────
add_host_to_file() {
    local total="${#SCAN_DISPLAY_HOSTS[@]}"
    (( total == 0 )) && return
    (( SCAN_CURSOR >= total )) && return

    local ip="${SCAN_DISPLAY_HOSTS[$SCAN_CURSOR]}"
    [[ -z "$ip" ]] && return

    # Find hostname from current scan state
    local name="" j
    for j in "${!SCAN_HOSTS[@]}"; do
        if [[ "${SCAN_HOSTS[$j]}" == "$ip" ]]; then
            name="${SCAN_NAMES[$j]}"
            break
        fi
    done

    local entry="${name:-$ip}"
    if grep -qF "$entry" "$HOSTS_FILE" 2>/dev/null; then
        FLASH_MSG="${entry} already in $(basename "$HOSTS_FILE")"
        FLASH_UNTIL=$(( $(date +%s) + 2 ))
        return
    fi

    if [[ -n "$name" && "$name" != "$ip" ]]; then
        printf "%s  # %s\n" "$name" "$ip" >> "$HOSTS_FILE"
    else
        printf "%s\n" "$ip" >> "$HOSTS_FILE"
    fi

    FLASH_MSG="Added ${entry} → $(basename "$HOSTS_FILE")"
    FLASH_UNTIL=$(( $(date +%s) + 3 ))
}

# ── scan mode: sort helpers ───────────────────────────────────────────────
get_sorted_scan_hosts() {
    local tmp; tmp=$(mktemp)
    local ip
    for ip in "${SCAN_SORT_BUF[@]}"; do
        local key
        case "$SCAN_SORT_MODE" in
            H)
                local dname="$ip" j
                for j in "${!SCAN_HOSTS[@]}"; do
                    if [[ "${SCAN_HOSTS[$j]}" == "$ip" && -n "${SCAN_NAMES[$j]}" ]]; then
                        dname="${SCAN_NAMES[$j]}"; break
                    fi
                done
                key="$dname"
                ;;
            S)
                if (( SNAPSHOT_MODE )); then
                    local snap_st="${SNAP_STATUS[$ip]:-absent}"
                    local cur_up="${SCAN_UP[$ip]:-0}"
                    if (( cur_up )) && [[ "$snap_st" != "up" ]]; then
                        key="0"   # newly appeared → sort first
                    elif (( ! cur_up )) && [[ "$snap_st" == "up" ]]; then
                        key="1"   # went down → sort second
                    else
                        key="2"   # unchanged → sort last
                    fi
                else
                    key=$(printf "%010d" "${SC_OKC[$ip]:-0}")
                fi
                ;;
            T)
                case $SCAN_T_CYCLE in
                    0|1) key=$(printf "%010d" "${SC_LFL[$ip]:-0}") ;;
                    2|3) key=$(printf "%010d" "${SC_FFL[$ip]:-0}") ;;
                esac
                ;;
            *)  # I = numeric IP (default)
                if [[ "$ip" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
                    key=$(printf "%03d%03d%03d%03d" \
                        "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" \
                        "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}")
                else
                    key="$ip"
                fi
                ;;
        esac
        printf "%s\t%s\n" "$key" "$ip"
    done > "$tmp"
    local do_rev=0
    [[ "$SCAN_SORT_MODE" == "T" ]] && (( SCAN_T_CYCLE % 2 == 1 )) && do_rev=1
    [[ "$SCAN_SORT_MODE" != "T" ]] && (( SCAN_SORT_REV ))          && do_rev=1
    if (( do_rev )); then
        sort -rk1,1 "$tmp"
    else
        sort -k1,1 "$tmp"
    fi | awk -F'\t' '{print $2}'
    rm -f "$tmp"
}

scan_sort_label() {
    local arr; (( SCAN_SORT_REV )) && arr="↓" || arr="↑"
    case "$SCAN_SORT_MODE" in
        H) printf "Name %s" "$arr" ;;
        S) (( SNAPSHOT_MODE )) && printf "Status %s" "$arr" || printf "OK# %s" "$arr" ;;
        T)
            case $SCAN_T_CYCLE in
                0) printf "Last Fail ↑" ;;
                1) printf "Last Fail ↓" ;;
                2) printf "First Fail ↑" ;;
                3) printf "First Fail ↓" ;;
            esac
            ;;
        *) printf "IP %s" "$arr" ;;
    esac
}

# ── draw scan mode ─────────────────────────────────────────────────────────
draw_scan() {
    local cols rows
    cols=$(tput cols)
    rows=$(tput lines)

    local W_HOST=22 W_IP=16 W_ST=3 W_CNT=11 W_TIME=20
    local hline
    hline=$(printf '─%.0s' $(seq 1 "$cols"))
    local data_rows=$(( rows - 6 ))
    (( data_rows < 0 )) && data_rows=0

    printf "\033[H"

    # Status bar
    local mode_label
    if (( SNAPSHOT_MODE )); then
        local bg_ind=""
        (( SNAP_HIDE_BG )) && bg_ind=" ${CD}bg:hidden${RS}"
        mode_label="${CB}[SNAPSHOT ${SNAPSHOT_TIME}]${RS}${bg_ind}"
    else
        mode_label="${CB}[SCAN ${SCAN_SUBNET_DISPLAY}]${RS}"
    fi

    local flash_part=""
    if [[ -n "$FLASH_MSG" ]] && (( $(date +%s) < FLASH_UNTIL )); then
        flash_part="  ${CG}${FLASH_MSG}${RS}"
    else
        FLASH_MSG=""
    fi

    printf "\033[2K${CB}PingInfoView v%s${RS}  %s  Found: %d  Sort: %s%s\n" \
        "$VERSION" "$mode_label" "${#SCAN_HOSTS[@]}" "$(scan_sort_label)" "$flash_part"
    printf "\033[2K%s\n" "$hline"
    printf "\033[2K${CB}%-${W_HOST}s %-${W_IP}s %-${W_ST}s %-${W_CNT}s %-${W_TIME}s %-${W_TIME}s${RS}\n" \
        "HOST" "IP" "ST" "OK / FAIL" "FAIL: FIRST → LAST" "OK: FIRST → LAST"
    printf "\033[2K%s\n" "$hline"

    # Build display list; in snapshot mode include hosts that went down
    local -a dh=()
    if (( SNAPSHOT_MODE )); then
        # Record every currently-up IP and its name into SNAP_SEEN/SNAP_NAMES
        local ip
        for ip in "${SCAN_HOSTS[@]}"; do
            SNAP_SEEN["$ip"]=1
            local j
            for j in "${!SCAN_HOSTS[@]}"; do
                if [[ "${SCAN_HOSTS[$j]}" == "$ip" && -n "${SCAN_NAMES[$j]}" ]]; then
                    SNAP_NAMES["$ip"]="${SCAN_NAMES[$j]}"; break
                fi
            done
        done

        # Promote confirmed dropouts into SNAP_DROP:
        #   baseline hosts (in SNAP_STATUS) that stopped responding
        for ip in "${!SNAP_STATUS[@]}"; do
            if [[ "${SNAP_STATUS[$ip]}" == "up" ]] && [[ "${SCAN_UP[$ip]:-0}" == "0" ]]; then
                SNAP_DROP["$ip"]=1
            fi
        done
        #   new arrivals (in SNAP_SEEN but not baseline) that stopped responding
        for ip in "${!SNAP_SEEN[@]}"; do
            if [[ -z "${SNAP_STATUS[$ip]}" ]] && [[ "${SCAN_UP[$ip]:-0}" == "0" ]]; then
                SNAP_DROP["$ip"]=1
            fi
        done

        local -A seen=()
        for ip in "${SCAN_HOSTS[@]}";    do seen["$ip"]=1; done
        for ip in "${!SNAP_STATUS[@]}";  do seen["$ip"]=1; done
        for ip in "${!SNAP_SEEN[@]}";    do seen["$ip"]=1; done
        local -a all_snap=()
        mapfile -t all_snap < <(printf '%s\n' "${!seen[@]}" \
            | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n)
        for ip in "${all_snap[@]}"; do
            local snap_st="${SNAP_STATUS[$ip]:-absent}"
            local cur_up="${SCAN_UP[$ip]:-0}"
            local dropped="${SNAP_DROP[$ip]:-0}"
            # Hide background (unchanged, not a confirmed dropout) when toggled
            if (( SNAP_HIDE_BG )) && (( ! dropped )) && (( cur_up )) && [[ "$snap_st" == "up" ]]; then
                continue
            fi
            dh+=("$ip")
        done
    else
        dh=("${SCAN_HOSTS[@]}")
    fi

    # Apply sort
    SCAN_SORT_BUF=("${dh[@]}")
    mapfile -t dh < <(get_sorted_scan_hosts)

    SCAN_DISPLAY_HOSTS=("${dh[@]}")

    # Clamp cursor
    local total="${#dh[@]}"
    (( total > 0 && SCAN_CURSOR >= total )) && SCAN_CURSOR=$(( total - 1 ))
    (( SCAN_CURSOR < 0 )) && SCAN_CURSOR=0

    # Scroll window so the cursor row is always visible
    local scroll=0
    (( total > data_rows && SCAN_CURSOR >= data_rows )) && \
        scroll=$(( SCAN_CURSOR - data_rows + 1 ))

    local printed=0 disp_idx
    for (( disp_idx=scroll; disp_idx<total && printed<data_rows; disp_idx++ )); do
        local ip="${dh[$disp_idx]}"

        # Display name: current scan arrays first, then snapshot name cache
        local dname="$ip" j
        for j in "${!SCAN_HOSTS[@]}"; do
            if [[ "${SCAN_HOSTS[$j]}" == "$ip" && -n "${SCAN_NAMES[$j]}" ]]; then
                dname="${SCAN_NAMES[$j]}"; break
            fi
        done
        [[ "$dname" == "$ip" && -n "${SNAP_NAMES[$ip]}" ]] && dname="${SNAP_NAMES[$ip]}"

        # Counts and timestamps from per-IP maps
        local okc="${SC_OKC[$ip]:-0}" flc="${SC_FLC[$ip]:-0}"
        local ff lf fo lo
        ff=$(fmt_time "${SC_FFL[$ip]:-}")
        lf=$(fmt_time "${SC_LFL[$ip]:-}")
        fo=$(fmt_time "${SC_FOK[$ip]:-}")
        lo=$(fmt_time "${SC_LOK[$ip]:-}")
        local fail_col ok_col
        [[ "$ff" == "-" ]] && fail_col="-" || fail_col="${ff}→${lf}"
        [[ "$fo" == "-" ]] && ok_col="-"   || ok_col="${fo}→${lo}"

        # Colour / symbol
        local sym color
        if (( SNAPSHOT_MODE )); then
            local snap_st="${SNAP_STATUS[$ip]:-absent}"
            local cur_up="${SCAN_UP[$ip]:-0}"
            local dropped="${SNAP_DROP[$ip]:-0}"
            if (( dropped )); then
                sym="$FAIL_SYM"; color="$CRR"   # confirmed dropout → persistent red
            elif (( cur_up )) && [[ "$snap_st" != "up" ]]; then
                sym="$OK_SYM";   color="$CGG"   # newly appeared → bright green
            else
                sym="$OK_SYM";   color="$CD"    # no change → dim
            fi
        else
            sym="$OK_SYM"; color="$CG"
        fi

        if (( disp_idx == SCAN_CURSOR )); then
            printf "\033[2K\033[7m${color}%-${W_HOST}s${RS}\033[7m %-${W_IP}s ${color}%-${W_ST}s${RS}\033[7m %-${W_CNT}s %-${W_TIME}s %-${W_TIME}s${RS}\033[27m\n" \
                "${dname:0:$W_HOST}" "${ip:0:$W_IP}" "$sym" \
                "${okc}/${flc}" "${fail_col:0:$W_TIME}" "${ok_col:0:$W_TIME}"
        else
            printf "\033[2K${color}%-${W_HOST}s${RS} %-${W_IP}s ${color}%-${W_ST}s${RS} %-${W_CNT}s %-${W_TIME}s %-${W_TIME}s\n" \
                "${dname:0:$W_HOST}" "${ip:0:$W_IP}" "$sym" \
                "${okc}/${flc}" "${fail_col:0:$W_TIME}" "${ok_col:0:$W_TIME}"
        fi

        (( printed++ ))
    done

    while (( printed < data_rows )); do
        printf "\033[2K\n"; (( printed++ ))
    done

    printf "\033[2K%s\n" "$hline"
    local b_hint=""
    (( SNAPSHOT_MODE )) && b_hint="  [B]=toggle bg"
    printf "\033[2K${CD}[H/I/S/T]=sort  [N]=exit scan  [A]=add  [P]=snapshot%s  [J/K/↑↓]=select  [Q]=quit${RS}" "$b_hint"
}

# ── time formatting ────────────────────────────────────────────────────────
fmt_time() {
    local epoch="$1"
    [[ -z "$epoch" ]] && printf "-" && return
    if [[ "$OS_TYPE" == "Darwin" ]]; then
        date -r "$epoch" "+%H:%M:%S" 2>/dev/null || printf "?"
    else
        date -d "@$epoch" "+%H:%M:%S" 2>/dev/null || printf "?"
    fi
}

# ── sorting ────────────────────────────────────────────────────────────────
sort_key() {
    local i="$1"
    case "$SORT_MODE" in
        H) printf "%s" "${hosts[$i]}" ;;
        I)
            local ip="${st_ip[$i]:-}"
            if [[ "$ip" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
                printf "%03d%03d%03d%03d" \
                    "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" \
                    "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"
            else
                printf "zzz%s" "$ip"
            fi
            ;;
        S)
            [[ "${st_status[$i]}" == "up" ]] && printf "0" || printf "1"
            ;;
        T)
            case $T_CYCLE in
                0|1) printf "%010d" "${st_last_fail[$i]:-0}" ;;
                2|3) printf "%010d" "${st_first_fail[$i]:-0}" ;;
            esac
            ;;
    esac
}

get_sorted_indices() {
    local tmp; tmp=$(mktemp)
    local i
    for i in "${!hosts[@]}"; do
        printf "%s\t%d\n" "$(sort_key "$i")" "$i"
    done > "$tmp"
    local do_rev=0
    [[ "$SORT_MODE" == "T" ]] && (( T_CYCLE % 2 == 1 )) && do_rev=1
    [[ "$SORT_MODE" != "T" ]] && (( SORT_REV ))          && do_rev=1
    if (( do_rev )); then
        sort -rk1,1 "$tmp"
    else
        sort -k1,1 "$tmp"
    fi | awk -F'\t' '{print $2}'
    rm -f "$tmp"
}

sort_label() {
    local arr; (( SORT_REV )) && arr="↓" || arr="↑"
    case "$SORT_MODE" in
        H) printf "Hostname %s" "$arr" ;;
        I) printf "IP %s"       "$arr" ;;
        S) printf "Status %s"   "$arr" ;;
        T)
            case $T_CYCLE in
                0) printf "Last Fail ↑" ;;
                1) printf "Last Fail ↓" ;;
                2) printf "First Fail ↑" ;;
                3) printf "First Fail ↓" ;;
            esac
            ;;
    esac
}

# ── draw normal mode ───────────────────────────────────────────────────────
draw() {
    local cols rows
    cols=$(tput cols)
    rows=$(tput lines)

    local W_HOST=22 W_IP=16 W_ST=3 W_CNT=11 W_TIME=20
    local hline
    hline=$(printf '─%.0s' $(seq 1 "$cols"))

    local data_rows=$(( rows - 6 ))
    (( data_rows < 0 )) && data_rows=0

    printf "\033[H"

    local site_part=""
    [[ -n "$SITE_LABEL" ]] && site_part="  ${CB}[${SITE_LABEL}]${RS}"

    local flash_part=""
    if [[ -n "$FLASH_MSG" ]] && (( $(date +%s) < FLASH_UNTIL )); then
        flash_part="  ${CG}${FLASH_MSG}${RS}"
    else
        FLASH_MSG=""
    fi

    printf "\033[2K${CB}PingInfoView v%s${RS}%s  Hosts: %d  Refresh: %ds  Sort: %s%s\n" \
        "$VERSION" "$site_part" "${#hosts[@]}" "$REFRESH" "$(sort_label)" "$flash_part"
    printf "\033[2K%s\n" "$hline"
    printf "\033[2K${CB}%-${W_HOST}s %-${W_IP}s %-${W_ST}s %-${W_CNT}s %-${W_TIME}s %-${W_TIME}s${RS}\n" \
        "HOST" "IP" "ST" "OK / FAIL" "FAIL: FIRST → LAST" "OK: FIRST → LAST"
    printf "\033[2K%s\n" "$hline"

    # Clamp cursor to current host count
    local total="${#hosts[@]}"
    (( total > 0 && NORM_CURSOR >= total )) && NORM_CURSOR=$(( total - 1 ))
    (( NORM_CURSOR < 0 )) && NORM_CURSOR=0

    local sorted_indices=()
    mapfile -t sorted_indices < <(get_sorted_indices)

    # Scroll so cursor is always visible
    local scroll=0
    (( total > data_rows && NORM_CURSOR >= data_rows )) && \
        scroll=$(( NORM_CURSOR - data_rows + 1 ))

    local printed=0 si
    for (( si=scroll; si<${#sorted_indices[@]} && printed<data_rows; si++ )); do
        local i="${sorted_indices[$si]}"

        local host="${hosts[$i]}"
        local ip="${st_ip[$i]:-}"
        local status="${st_status[$i]:-unknown}"
        local ok="${st_ok[$i]:-0}"
        local fail="${st_fail[$i]:-0}"

        local ff lf fo lo
        ff=$(fmt_time "${st_first_fail[$i]:-}")
        lf=$(fmt_time "${st_last_fail[$i]:-}")
        fo=$(fmt_time "${st_first_ok[$i]:-}")
        lo=$(fmt_time "${st_last_ok[$i]:-}")

        local fail_col ok_col
        [[ "$ff" == "-" ]] && fail_col="-" || fail_col="${ff}→${lf}"
        [[ "$fo" == "-" ]] && ok_col="-"   || ok_col="${fo}→${lo}"

        local sym color
        case "$status" in
            up)   sym="$OK_SYM";   color="$CG" ;;
            down) sym="$FAIL_SYM"; color="$CR" ;;
            *)    sym="?";          color="$CD" ;;
        esac

        if (( si == NORM_CURSOR )); then
            printf "\033[2K\033[7m${color}%-${W_HOST}s${RS}\033[7m %-${W_IP}s ${color}%-${W_ST}s${RS}\033[7m %-${W_CNT}s %-${W_TIME}s %-${W_TIME}s${RS}\033[27m\n" \
                "${host:0:$W_HOST}" "${ip:0:$W_IP}" "$sym" \
                "${ok}/${fail}" \
                "${fail_col:0:$W_TIME}" "${ok_col:0:$W_TIME}"
        else
            printf "\033[2K${color}%-${W_HOST}s${RS} %-${W_IP}s ${color}%-${W_ST}s${RS} %-${W_CNT}s %-${W_TIME}s %-${W_TIME}s\n" \
                "${host:0:$W_HOST}" "${ip:0:$W_IP}" "$sym" \
                "${ok}/${fail}" \
                "${fail_col:0:$W_TIME}" "${ok_col:0:$W_TIME}"
        fi

        (( printed++ ))
    done

    while (( printed < data_rows )); do
        printf "\033[2K\n"; (( printed++ ))
    done

    printf "\033[2K%s\n" "$hline"
    printf "\033[2K${CD}[H]ost  [I]P  [S]tatus  [T]ime  [R]efresh  [E]dit  [D]=remove  [J/K/↑↓]=select  [N]=scan  [Q/ESC] Quit${RS}"
}

# ── key handlers ───────────────────────────────────────────────────────────
prompt_refresh() {
    local rows; rows=$(tput lines)
    tput cup $((rows - 1)) 0
    printf "\033[2K${CB}New refresh rate in seconds (≥1): ${RS}"
    tput cnorm
    local val
    read -r val
    tput civis
    [[ "$val" =~ ^[1-9][0-9]*$ ]] && REFRESH="$val"
}

edit_hosts() {
    tput rmcup
    tput cnorm
    nano "$HOSTS_FILE"
    load_hosts
    init_state
    trigger_pings
    tput smcup
    tput civis
    clear
}

dig_host() {
    local target
    if (( SCAN_MODE )); then
        local total="${#SCAN_DISPLAY_HOSTS[@]}"
        (( total == 0 || SCAN_CURSOR >= total )) && return
        local ip="${SCAN_DISPLAY_HOSTS[$SCAN_CURSOR]}"
        # prefer resolved name if available
        local name="" j
        for j in "${!SCAN_HOSTS[@]}"; do
            [[ "${SCAN_HOSTS[$j]}" == "$ip" ]] && name="${SCAN_NAMES[$j]}" && break
        done
        target="${name:-$ip}"
    else
        local total="${#hosts[@]}"
        (( total == 0 || NORM_CURSOR >= total )) && return
        local sorted_indices=()
        mapfile -t sorted_indices < <(get_sorted_indices)
        target="${hosts[${sorted_indices[$NORM_CURSOR]}]}"
    fi

    if ! command -v dig &>/dev/null; then
        apt-get install -y dnsutils &>/dev/null
    fi

    tput rmcup
    tput cnorm
    printf "\033[1mdig %s\033[0m\n\n" "$target"
    dig "$target" 2>&1
    printf "\n\033[2mPress any key to return…\033[0m"
    read -rsn1
    tput smcup
    tput civis
    clear
}

handle_key() {
    local key="$1" seq="${2:-}"

    if (( SCAN_MODE )); then
        local total="${#SCAN_DISPLAY_HOSTS[@]}"
        # Arrow keys (escape sequences) and vim-style J/K
        if [[ "$seq" == "[A" ]] || [[ "${key^^}" == "K" ]]; then
            (( SCAN_CURSOR > 0 )) && (( SCAN_CURSOR-- ))
            return
        elif [[ "$seq" == "[B" ]] || [[ "${key^^}" == "J" ]]; then
            (( total > 0 && SCAN_CURSOR < total - 1 )) && (( SCAN_CURSOR++ ))
            return
        fi
        case "${key^^}" in
            H|I|S)
                local m="${key^^}"
                if [[ "$SCAN_SORT_MODE" == "$m" ]]; then
                    SCAN_SORT_REV=$(( 1 - SCAN_SORT_REV ))
                else
                    SCAN_SORT_MODE="$m"; SCAN_SORT_REV=0
                fi
                SCAN_CURSOR=0
                ;;
            T)
                if [[ "$SCAN_SORT_MODE" == "T" ]]; then
                    SCAN_T_CYCLE=$(( (SCAN_T_CYCLE + 1) % 4 ))
                else
                    SCAN_SORT_MODE="T"; SCAN_T_CYCLE=0
                fi
                SCAN_CURSOR=0
                ;;
            D) dig_host ;;
            N) exit_scan_mode ;;
            A) add_host_to_file ;;
            P)
                if (( SNAPSHOT_MODE )); then
                    SNAPSHOT_MODE=0; SNAP_HIDE_BG=0; SNAP_STATUS=(); SNAP_DROP=(); SNAP_SEEN=(); SNAP_NAMES=()
                else
                    take_snapshot
                fi
                ;;
            B)
                if (( SNAPSHOT_MODE )); then
                    SNAP_HIDE_BG=$(( 1 - SNAP_HIDE_BG ))
                    SNAP_DROP=()
                    SNAP_SEEN=()
                    SNAP_NAMES=()
                    SCAN_CURSOR=0
                fi
                ;;
            Q) cleanup ;;
        esac
        return
    fi

    local total="${#hosts[@]}"
    # Arrow keys (escape sequences) and vim-style J/K for normal mode
    if [[ "$seq" == "[A" ]] || [[ "${key^^}" == "K" ]]; then
        (( NORM_CURSOR > 0 )) && (( NORM_CURSOR-- ))
        return
    elif [[ "$seq" == "[B" ]] || [[ "${key^^}" == "J" ]]; then
        (( total > 0 && NORM_CURSOR < total - 1 )) && (( NORM_CURSOR++ ))
        return
    fi

    case "${key^^}" in
        H|I|S)
            local m="${key^^}"
            if [[ "$SORT_MODE" == "$m" ]]; then
                SORT_REV=$(( 1 - SORT_REV ))
            else
                SORT_MODE="$m"; SORT_REV=0
            fi
            NORM_CURSOR=0
            ;;
        T)
            if [[ "$SORT_MODE" == "T" ]]; then
                T_CYCLE=$(( (T_CYCLE + 1) % 4 ))
            else
                SORT_MODE="T"; T_CYCLE=0
            fi
            NORM_CURSOR=0
            ;;
        D) dig_host ;;
        R) remove_host_from_file ;;
        F) prompt_refresh ;;
        N) enter_scan_mode ;;
        E) edit_hosts ;;
        Q) cleanup ;;
    esac
}

# ── main ───────────────────────────────────────────────────────────────────
main() {
    load_hosts
    init_state

    tput smcup
    tput civis
    clear

    trigger_pings
    local last_ping
    last_ping=$(date +%s)

    while true; do
        if (( SCAN_MODE )); then
            read_scan_state
            draw_scan
        else
            read_state
            draw
        fi

        local key="" seq=""
        if read -rsn1 -t "$REFRESH" key 2>/dev/null; then
            if [[ "$key" == $'\x1b' ]]; then
                read -rsn2 -t 0.05 seq 2>/dev/null || true
                if [[ -z "$seq" ]]; then
                    cleanup
                else
                    handle_key "" "$seq"
                fi
                key=""
            fi
            [[ -n "$key" ]] && handle_key "$key"
        fi

        local now
        now=$(date +%s)
        if (( now - last_ping >= REFRESH )); then
            if (( SCAN_MODE )); then
                trigger_scan
            else
                trigger_pings
            fi
            last_ping=$now
        fi
    done
}

main
